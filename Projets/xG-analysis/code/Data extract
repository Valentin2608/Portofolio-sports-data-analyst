import json
from pathlib import Path
import pandas as pd

# =========================
# Paths (adaptés à ton projet)
# =========================
BASE_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = BASE_DIR / "data"
OUTPUT_DIR = BASE_DIR / "result"
OUTPUT_PATH = OUTPUT_DIR / "shots_raw.csv"

# =========================
# Extraction des tirs
# =========================
shots = []

for file in DATA_DIR.glob("*.json"):
    match_id = file.stem
    with open(file, "r", encoding="utf-8") as f:
        events = json.load(f)

    for event in events:
        if event.get("type", {}).get("name") == "Shot":

            location = event.get("location", [None, None])
            shot = event.get("shot", {})

            shots.append({
                "match_id": match_id,
                "team": event.get("team", {}).get("name"),
                "player": event.get("player", {}).get("name"),
                "x": location[0],
                "y": location[1],
                "outcome": shot.get("outcome", {}).get("name"),
                "body_part": shot.get("body_part", {}).get("name"),
                "shot_type": shot.get("type", {}).get("name")
            })

# =========================
# DataFrame + sauvegarde
# =========================
shots_df = pd.DataFrame(shots)

OUTPUT_DIR.mkdir(exist_ok=True)
shots_df.to_csv(OUTPUT_PATH, index=False)

print(f"{len(shots_df)} tirs extraits")
print(f"Fichier créé : {OUTPUT_PATH}")

